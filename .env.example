HEVY_API_KEY=your-hevy-api-key-here

# ── AI provider — pick one ────────────────────────────────────────────────────
AI_PROVIDER=gemini   # gemini | claude | openrouter | groq | github | bedrock

# Gemini (default) — free tier available
# https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# Claude (Anthropic direct)
# https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter — access 100+ models via one key
# https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key

# Groq — fast inference, Llama / Mixtral / Gemma
# https://console.groq.com
GROQ_API_KEY=gsk_your-key

# GitHub Models — GPT-4o and others via Azure
# https://github.com/marketplace/models — use a GitHub personal access token
GITHUB_TOKEN=ghp_your-token

# Amazon Bedrock
# pip install "anthropic[bedrock]"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token   # only needed for temporary credentials

# Optional: override the default model for the chosen provider
# AI_MODEL=gemini-2.5-flash
# AI_MODEL=claude-sonnet-4-6
# AI_MODEL=meta-llama/llama-3.3-70b-instruct   (OpenRouter)
# AI_MODEL=llama-3.3-70b-versatile              (Groq)
# AI_MODEL=gpt-4o-mini                          (GitHub)
# AI_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0  (Bedrock)

# ── Google Fit (optional) ─────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=fit_credentials.json

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=hevy.db

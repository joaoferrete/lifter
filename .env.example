# ── Hevy API key ─────────────────────────────────────────────────────────────
# Hevy API key and database path are now per-profile.
# Enter your key when Lifter prompts you on first run, or via Settings → Profiles.

# ── AI provider — pick one ────────────────────────────────────────────────────
AI_PROVIDER=gemini   # gemini | claude | openrouter | groq | github | bedrock

# Gemini (default) — free tier available
# https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# Claude (Anthropic direct)
# https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter — access 100+ models via one key
# https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key

# Groq — fast inference
# https://console.groq.com
GROQ_API_KEY=gsk_your-key

# GitHub Models — GPT-4o and others
# https://github.com/marketplace/models
# Use a GitHub personal access token (fine-grained) with the "models:read" permission.
GITHUB_TOKEN=ghp_your-token

# Amazon Bedrock — two auth options:
#   A) Bearer token (Bedrock API key) — Claude models work with NO boto3 install.
#   B) AWS credentials via boto3 — pip install "anthropic[bedrock]".
AWS_REGION=us-east-1
# Option A — Bedrock API key / bearer token (recommended if you can't use boto3):
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# Option B — AWS credentials:
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token   # only needed for temporary credentials

# Optional: override the default model for the chosen provider
# AI_MODEL=gemini-3.5-flash
# AI_MODEL=claude-sonnet-4-6
# AI_MODEL=anthropic/claude-sonnet-4.6          (OpenRouter)
# AI_MODEL=openai/gpt-oss-120b                  (Groq)
# AI_MODEL=openai/gpt-4o                         (GitHub — publisher/model format)
# AI_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0  (Bedrock; or us./eu./global. inference profile)

# ── Language (optional) ───────────────────────────────────────────────────────
# UI language shown before a profile is selected. Options: en, pt_BR
# Per-profile language can be changed via Settings → Preferences → UI language
# DEFAULT_LANGUAGE=en

# ── Google Fit (optional) ─────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=fit_credentials.json

# ── Database ──────────────────────────────────────────────────────────────────
# DB_PATH is managed automatically per-profile under profiles/{slug}/hevy.db.
# You do not need to set this manually.
